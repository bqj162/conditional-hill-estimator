{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug sim_study (run as module)",
      "type": "python",
      "request": "launch",
      "module": "src.simulation.sim_study",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "-s", "^GDAXI,^GDAXI",
        "-fd", "1995-01-01",
        "-td", "2015-07-01",
        "-t", "log_diff",
        "-l", "0"
      ],
      "justMyCode": true
    }
  ]
}
